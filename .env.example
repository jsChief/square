# Copy this file to .env.local and fill in the values for your environment.

# Supabase project values. The anon key is public-safe; never put a
# service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional absolute origin (for example https://square.example.com) used when
# building Supabase Auth confirmation and password-reset links. When omitted,
# the request's host is used.
NEXT_PUBLIC_SITE_URL=

# Optional. AI_PROVIDER can be openai, anthropic, or google; leave blank to
# auto-detect from the keys below. With no key, /api/ai returns a labelled
# sample draft instead of calling a model.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Paystack. The public key is safe for the browser; the secret key is used only
# on the server to verify charges. Both keys must be from the same Paystack
# mode (both test or both live), otherwise online payments are disabled.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
